{
  "name": "@stubwise/sdk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    "./browser": {
      "types": "./dist/browser.d.ts",
      "default": "./dist/browser.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@stubwise/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.19.20",
    "happy-dom": "^20.10.2",
    "typescript": "^5.6.0",
    "vitest": "^3.2.0"
  }
}
