{
  "name": "@stubwise/sdk",
  "version": "0.1.0",
  "description": "Official Stubwise SDK: capture errors and send feedback from browser and Node.js apps to a self-hosted Stubwise instance.",
  "license": "MIT",
  "homepage": "https://github.com/stubwise/stubwise#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stubwise/stubwise.git",
    "directory": "packages/sdk"
  },
  "bugs": {
    "url": "https://github.com/stubwise/stubwise/issues"
  },
  "keywords": [
    "stubwise",
    "error-tracking",
    "error-reporting",
    "issue-tracker",
    "observability",
    "sdk"
  ],
  "type": "module",
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "exports": {
    "./browser": {
      "types": "./dist/browser.d.ts",
      "default": "./dist/browser.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@stubwise/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.19.20",
    "happy-dom": "^20.10.2",
    "typescript": "^5.6.0",
    "vitest": "^3.2.0"
  }
}
