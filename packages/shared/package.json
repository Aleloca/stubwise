{
  "name": "@stubwise/shared",
  "version": "0.1.0",
  "description": "Shared Zod domain schemas and types for Stubwise (events, tickets, projects). Used by the Stubwise SDK, server and web app.",
  "license": "MIT",
  "homepage": "https://github.com/stubwise/stubwise#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stubwise/stubwise.git",
    "directory": "packages/shared"
  },
  "bugs": {
    "url": "https://github.com/stubwise/stubwise/issues"
  },
  "keywords": [
    "stubwise",
    "zod",
    "schemas",
    "types"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "vitest": "^3.2.0"
  }
}
