{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // Override del base (NodeNext): il codice è bundlato da Vite.
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    // Preact via il runtime JSX automatico: nessun import di React necessario.
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "types": ["vite/client"]
  },
  "include": ["src", "vite.config.ts"]
}
