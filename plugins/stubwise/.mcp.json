{
  "mcpServers": {
    "stubwise": {
      "command": "npx",
      "args": [
        "-y",
        "@stubwise/mcp@0.9.0"
      ],
      "env": {
        "STUBWISE_TOKEN": "${STUBWISE_TOKEN:-}",
        "STUBWISE_URL": "${STUBWISE_URL:-}",
        "STUBWISE_PLUGIN_VERSION": "0.2.0"
      }
    }
  }
}
