# Caddyfile di Stubwise.
#
# {$DOMAIN} è l'indirizzo del sito:
#   - DOMAIN=stubwise.example.com  -> HTTPS automatico (Let's Encrypt).
#   - DOMAIN=localhost             -> HTTPS con CA interna di Caddy (self-signed).
#   - DOMAIN=:80                   -> solo HTTP, niente TLS (utile per gli smoke
#                                     test locali dietro il proxy).
#
# Caddy serve:
#   - /api/*, /ingest/*, /webhooks/*  -> reverse proxy al server Fastify.
#   - /widget/*                       -> reverse proxy al server (API pubblica
#                                        del widget customer service).
#   - /widget.js                      -> bundle IIFE embeddabile (da /srv/widget).
#   - /app/*                          -> la nuova app (il renderer dell'app desktop
#                                        in modo «app», da /srv/app), con fallback
#                                        a index.html. Il web vecchio resta alla
#                                        radice (integrazione area 2, fetta 1).
#   - /guide/*                        -> statici della documentazione utente
#                                        (sito Starlight). NB: NON /docs/*, che è
#                                        una sezione della SPA (documentazione
#                                        autogenerata per progetto).
#   - tutto il resto (incl. /docs/*)  -> SPA (con fallback a index.html per il
#                                        client-side routing).

# La CSP delle pagine statiche dell'origine (indurimento di sicurezza, C1/M1):
# un HEADER, mai un <meta>. La stessa base di `scripts/caddy-csp.mjs`
# (BASE_DIRECTIVES), che il test `scripts/caddy-csp.test.mjs` tiene d'accordo
# con questa riga. Niente `'unsafe-inline'` né `'unsafe-eval'` per gli script:
# il web vecchio e l'app non hanno script inline (lo controlla il build), la
# guida li ammette per hash (frammento generato, sotto).
(csp_strict) {
	header Content-Security-Policy "script-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; connect-src 'self'"
}

{$DOMAIN} {
	encode zstd gzip

	# Header di sicurezza ragionevoli. HSTS solo quando c'e TLS; innocuo in
	# HTTP puro (i browser lo ignorano senza https).
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# Nessun Service Worker sull'origine (seconda revisione di sicurezza della
	# cassaforte nel browser, m-7): il browser manda `Service-Worker: script`
	# quando registra o aggiorna un worker, e qui si rifiuta, qualunque sia il
	# file. Uno script iniettato non installa così un intermediario che resti
	# fra le schede e le richieste dopo che l'XSS è chiuso. È il PRIMO `handle`
	# del sito: i `handle` sono esclusivi, e un `respond` fuori da un `handle`
	# girerebbe dopo di loro.
	@serviceWorkerScript header Service-Worker script
	handle @serviceWorkerScript {
		respond 403
	}

	# Eccezione al DENY globale: la vista HTML del grafo graphify DEVE stare
	# nell'<iframe sandbox> della tab Grafo della SPA (same-origin). Il framing
	# resta comunque vincolato: il server manda `frame-ancestors 'self'` nella
	# CSP di quella risposta, che nei browser moderni e la fonte di verita.
	@graphHtml path_regexp ^/api/repositories/[0-9a-fA-F-]+/graph/html$
	header @graphHtml -X-Frame-Options

	# Superficie API/ingest/webhook -> server. Caddy aggiunge X-Forwarded-Proto
	# e X-Forwarded-For: il server con TRUST_PROXY=true li onora (cookie Secure).
	# Dentro un `handle` (mutuamente esclusivo con gli altri handle sotto) così
	# ha la precedenza sul file_server della SPA.
	# NB: di /monitor si proxano SOLO i due path API della superficie agente
	# (esatti, niente wildcard): le route SPA sotto /monitor (lista e dettaglio
	# server) devono cadere sul fallback SPA qui sotto. Gli id server sono uuid,
	# quindi /monitor/servers/<uuid> non collide mai con ingest/config.
	# /go/* sono i rimandi dei link del web vecchio verso la nuova app
	# (`apps/server/src/routes/go.ts`): accesi già, nessun link ci porta finché
	# non si accendono le regole del ritiro qui sotto.
	@backend path /api/* /ingest/* /webhooks/* /widget/* /monitor/ingest /monitor/config /go/*
	handle @backend {
		reverse_proxy {$SERVER_UPSTREAM:server:3000}
	}

	# Bundle IIFE del widget embeddabile, servito come /widget.js dal file
	# statico stubwise-widget.iife.js (in /srv/widget). Deve stare PRIMA del
	# blocco SPA `handle` (i `handle` sono valutati in ordine e mutuamente
	# esclusivi). NB: il matcher @backend usa /widget/* (richiede un segmento
	# dopo /widget/) e NON intercetta /widget.js; in più questo handle viene
	# comunque prima del fallback SPA. Cache moderata: i siti clienti non
	# riscaricano il bundle a ogni pageview, ma gli update arrivano in 5 minuti.
	handle /widget.js {
		root * /srv/widget
		rewrite * /stubwise-widget.iife.js
		header Cache-Control "public, max-age=300"
		file_server
	}

	# Documentazione utente statica (sito Starlight buildato in /srv/docs),
	# servita sotto /guide/*. Deve restare PRIMA del blocco SPA `handle` qui
	# sotto (i due `handle` sono mutuamente esclusivi e valutati nell'ordine).
	# Sta su /guide e NON su /docs proprio per non intercettare i deep link
	# della sezione "Docs" della SPA (/docs, /docs/:projectId, ...), che ora
	# ricade nel fallback SPA.
	handle_path /guide/* {
		# La CSP della guida: la base più gli hash degli script inline di
		# Starlight e WebAssembly per la ricerca (Pagefind). Il frammento lo
		# scrive `scripts/caddy-csp.mjs` nel build dell'immagine (Dockerfile.caddy).
		import /etc/caddy/csp-guide.caddy
		root * /srv/docs
		try_files {path} {path}/ /index.html
		file_server
	}

	# La nuova app (integrazione area 2, fetta 1): lo stesso renderer dell'app
	# desktop, buildato in modo «app» con `base: "/app/"` (in /srv/app), sulla
	# stessa origine del web vecchio: le sue chiamate `/api/…` usano il cookie
	# di sessione del web. Il router è a hash (`#/p/…`), quindi il fallback
	# serve solo per `/app/` e i suoi asset. PRIMA del `handle` della SPA.
	# La pagina A SÉ della cassaforte (revisione di sicurezza della fase 2,
	# I-2; design della cassaforte nel browser §10): un documento suo
	# (`vault.html`, buildato a sé in /srv/vault), con dentro solo il worker
	# della cassaforte e le sue pagine (attivare, la propria chiave, il kit, il
	# recupero, l'associazione di un Mac, le passkey). La SUA CSP, più stretta
	# di quella dell'origine: è la sola (niente `csp_strict`). Ci si entra con
	# una navigazione completa. PRIMA del blocco di /app (un `handle_path` più
	# specifico, e comunque sopra). Con l'app alla radice (R1) diventa /vault/.
	# La stringa è `VAULT_PAGE_CSP` di scripts/caddy-csp.mjs (il test la tiene d'accordo).
	redir /app/vault /app/vault/ 308
	handle_path /app/vault/* {
		header Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self'; font-src 'self'; connect-src 'self'; worker-src 'self'; form-action 'none'; frame-ancestors 'none'; base-uri 'none'; require-trusted-types-for 'script'; trusted-types stubwise-vault-worker"
		# Seconda revisione, I-1: `same-origin` non separa una pagina della STESSA
		# origine (l'app che la apre o la segue la governerebbe prima del boot).
		# `VAULT_PAGE_COOP` di scripts/caddy-csp.mjs; la prova è
		# `pnpm --filter @stubwise/desktop verify:vault-isolation`.
		header Cross-Origin-Opener-Policy "noopener-allow-popups"
		@vaultDocument not path /assets/*
		header @vaultDocument Cache-Control "no-store"
		root * /srv/vault
		try_files {path} /vault.html
		file_server
	}

	redir /app /app/ 308
	handle_path /app/* {
		import csp_strict
		# COOP: una finestra aperta da un'altra origine non tiene un riferimento
		# all'app (nota della cassaforte nel browser, §2.2 e M4).
		header Cross-Origin-Opener-Policy "same-origin"
		# Cassaforte nel browser, revisione I-4 (§2.3): Trusted Types sulla
		# nuova app, e il worker della cassaforte dal file del bundle. Un
		# SECONDO campo CSP: si somma a quello dell'origine (valgono tutti e due).
		# Solo le due politiche nostre, senza `default` e senza duplicati.
		header +Content-Security-Policy "require-trusted-types-for 'script'; trusted-types stubwise-vault-worker stubwise-html; worker-src 'self'"
		# index.html (e il fallback) mai in cache: un deploy, o una revoca, arriva
		# al primo caricamento. Gli asset hanno l'hash nel nome e restano in cache.
		@appDocument not path /assets/*
		header @appDocument Cache-Control "no-store"
		root * /srv/app
		try_files {path} /index.html
		file_server
	}

	# --- Ritiro del web vecchio: SPENTO, si accende al ritiro ---------------
	# (design `docs/plans/2026-11-27-link-nuova-app-design.md`, «Da fare al
	# ritiro»). Card, email, push e webhook già spediti portano i percorsi del
	# web vecchio. Quelli con un ID vanno ai rimandi del server (`/go/…`), che
	# risolvono l'id coi codici e rispondono 302 alla nuova app: Caddy i codici
	# non li conosce. Gli altri vanno diretti. Al ritiro: togliere i `#` di
	# questo blocco, e al posto del blocco SPA qui sotto mandare il resto del
	# web vecchio alla nuova app (o portare /app alla radice).
	# Va PRIMA del blocco SPA (i `handle` sono valutati in ordine).
	#
	# @legacyById path /tickets/* /backlog /backlog/* /projects/* /docs/* /monitor/servers/* /agents/job/*
	# handle @legacyById {
	# 	rewrite * /go{uri}
	# 	reverse_proxy {$SERVER_UPSTREAM:server:3000}
	# }
	# redir /settings/security /app/#/preferences/security 302
	# redir /settings/account /app/#/preferences/account 302
	# redir /settings/notifications /app/#/preferences/notifications 302
	# redir /inbox /app/#/home 302
	# -----------------------------------------------------------------------

	# SPA: tutto il resto (incluso /docs/* della sezione Docs) serve i file
	# statici, con fallback a index.html per le route gestite dal router lato
	# client.
	handle {
		import csp_strict
		root * /srv/web
		try_files {path} /index.html
		file_server
	}
}

# Blocchi di sito AGGIUNTIVI, montati dall'host (./caddy.d -> /etc/caddy/conf.d).
# Oggi ce n'è uno solo: il relay push sul nostro VPS (vedi caddy.d/README.md).
#
# ⚠️ La forma è un GLOB, e non è intercambiabile con le alternative che
# sembrano più dirette. Verificato con `caddy validate` su caddy:2-alpine:
#
#   - `push.{$PUSH_RELAY_HOST} { ... }` messo qui dentro con la variabile NON
#     impostata NON si disattiva: l'indirizzo diventa `push.` e Caddy RIFIUTA
#     l'intera configurazione ("subject does not qualify for certificate:
#     'push.'", exit 1). Non romperebbe solo il relay: romperebbe il sito di
#     OGNI istanza self-hosted. Non esiste una sintassi condizionale per un
#     indirizzo di sito.
#   - `push.{$PUSH_RELAY_HOST:localhost}` (variabile con default) è valido, ma
#     lascia un sito fantasma `push.localhost` a tutti: con `DOMAIN=:80` fa
#     comparire un listener `:443` che prima non c'era (verificato con `caddy
#     adapt`), cioè cambia il comportamento di chi il relay non lo usa.
#   - `import Caddyfile.relay` LETTERALE con il file assente è un errore ("File
#     to import not found"). Solo il glob tollera lo zero-match.
#
# Un glob che non matcha niente è configurazione valida (exit 0), e la dir può
# anche non esistere affatto: per le istanze self-hosted la configurazione resta
# identica a com'era, senza listener in più. Il file `.example` in caddy.d NON
# matcha `*.caddy` e resta quindi inerte finché non lo si copia.
import /etc/caddy/conf.d/*.caddy
