---
/**
 * Conditional Header override: the landing page gets a graphify-style floating
 * pill nav; every other page keeps the default Starlight header (search,
 * theme picker, sidebar toggle). The landing's global CSS strips the native
 * header chrome via :root:has(.sw-landing).
 */
import Default from "@astrojs/starlight/components/Header.astro";
import Search from "@astrojs/starlight/components/Search.astro";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const l = (path: string) => `${base}/${path}`;
const GITHUB = "https://github.com/Aleloca/stubwise";
const path = Astro.url.pathname;
const isLanding = path === `${base}/` || path === base;
---

{
  isLanding ? (
    <div class="pillwrap">
      <nav class="pill" aria-label="Main">
        <a class="pill-brand" href={`${base}/`} translate="no">
          <span class="pb-square" aria-hidden="true" />
          <span>stubwise</span>
          <span class="pb-cursor" aria-hidden="true">
            _
          </span>
        </a>
        <span class="pill-sep" aria-hidden="true" />
        <div class="pill-links">
          <a href="#document">Platform</a>
          <a href="#how">How it works</a>
          <a href="#faq">FAQ</a>
          <a href={l("getting-started/self-hosting/")}>Docs</a>
        </div>
        <div class="pill-actions">
          <div class="pill-search">
            <Search />
          </div>
          <a class="pill-gh" href={GITHUB}>
            ★ GitHub
          </a>
          <a class="pill-cta" href={l("getting-started/self-hosting/")}>
            &gt;_ Get started
          </a>
        </div>
      </nav>
    </div>
  ) : (
    <Default />
  )
}

<style>
  .pillwrap {
    display: flex;
    justify-content: center;
    width: 100%;
    padding-top: 0.9rem;
  }
  .pill {
    display: flex;
    align-items: center;
    gap: 1.6rem;
    max-width: 64rem;
    padding: 0.5rem 0.55rem 0.5rem 1.35rem;
    border: 1px solid #2a2d36;
    border-radius: 999px;
    background: rgb(13 15 20 / 0.82);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    box-shadow: 0 18px 48px -20px rgb(0 0 0 / 0.7);
    font-family: "IBM Plex Mono", ui-monospace, "SF Mono", Menlo, monospace;
  }
  .pill-brand {
    display: inline-flex;
    align-items: baseline;
    font-weight: 600;
    font-size: 1rem;
    letter-spacing: -0.02em;
    color: #e9eaee;
    text-decoration: none;
    white-space: nowrap;
    user-select: none;
  }
  .pb-square {
    display: inline-block;
    width: 0.62em;
    height: 0.62em;
    margin-right: 0.5em;
    transform: translateY(1px);
    background: #f5a623;
  }
  .pb-cursor {
    color: #f5a623;
    animation: pill-blink 1.1s step-end infinite;
  }
  @keyframes pill-blink {
    0%,
    60% {
      opacity: 1;
    }
    61%,
    100% {
      opacity: 0;
    }
  }
  .pill-sep {
    width: 1px;
    height: 1.4rem;
    background: #2a2d36;
  }
  .pill-links {
    display: flex;
    align-items: center;
    gap: 1.6rem;
  }
  .pill-links a {
    font-size: 0.8rem;
    font-weight: 500;
    color: #b6bcc8;
    text-decoration: none;
    white-space: nowrap;
    transition: color 0.15s ease;
  }
  .pill-links a:hover {
    color: #f5a623;
  }
  .pill-actions {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-left: 0.5rem;
  }
  /* Starlight's Search button, restyled to sit inside the pill. */
  .pill-search :global(button[data-open-modal]) {
    display: flex;
    align-items: center;
    gap: 0.5em;
    height: auto;
    margin: 0;
    padding: 0.42em 0.95em;
    border: 1px solid #2a2d36;
    border-radius: 999px;
    background: transparent;
    color: #b6bcc8;
    font-family: inherit;
    font-size: 0.76rem;
    font-weight: 600;
    cursor: pointer;
    transition:
      border-color 0.15s ease,
      color 0.15s ease;
  }
  .pill-search :global(button[data-open-modal]:hover) {
    border-color: #f5a623;
    color: #f5a623;
  }
  .pill-search :global(button[data-open-modal] kbd) {
    background: transparent;
    color: inherit;
    padding-inline: 0;
  }
  .pill-gh {
    padding: 0.42em 0.95em;
    border: 1px solid #2a2d36;
    border-radius: 999px;
    font-size: 0.76rem;
    font-weight: 600;
    color: #dfe2e9;
    text-decoration: none;
    white-space: nowrap;
    transition:
      border-color 0.15s ease,
      color 0.15s ease;
  }
  .pill-gh:hover {
    border-color: #f5a623;
    color: #f5a623;
  }
  .pill-cta {
    padding: 0.42em 1.05em;
    border-radius: 999px;
    background: #f5a623;
    font-size: 0.76rem;
    font-weight: 700;
    color: #16130a;
    text-decoration: none;
    white-space: nowrap;
    box-shadow: 0 8px 20px -8px rgb(245 166 35 / 0.6);
    transition: transform 0.15s ease;
  }
  .pill-cta:hover {
    transform: translateY(-1px);
  }

  /* Light theme */
  :global([data-theme="light"]) .pill {
    border-color: #dedbd0;
    background: rgb(255 254 251 / 0.85);
    box-shadow: 0 18px 48px -26px rgb(25 26 30 / 0.35);
  }
  :global([data-theme="light"]) .pill-brand {
    color: #191a1e;
  }
  :global([data-theme="light"]) .pill-sep {
    background: #dedbd0;
  }
  :global([data-theme="light"]) .pill-links a {
    color: #5f6470;
  }
  :global([data-theme="light"]) .pill-links a:hover {
    color: #b97a0f;
  }
  :global([data-theme="light"]) .pill-gh {
    border-color: #dedbd0;
    color: #191a1e;
  }

  @media (max-width: 54rem) {
    .pill-links,
    .pill-sep,
    .pill-gh {
      display: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .pb-cursor {
      animation: none;
    }
    .pill-cta {
      transition: none;
    }
  }
</style>
