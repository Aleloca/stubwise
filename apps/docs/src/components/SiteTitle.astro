---
/**
 * Override del SiteTitle di Starlight: rende il wordmark di Stubwise al posto
 * del titolo testuale. Replica `apps/web/src/components/wordmark.tsx` —
 * quadrato ambra + "stubwise" minuscolo in IBM Plex Mono semibold + cursore
 * ambra lampeggiante. `siteTitleHref` rispetta già l'Astro `base` (/docs).
 */
import "@fontsource/ibm-plex-mono/600.css";

const { siteTitleHref, siteTitle } = Astro.locals.starlightRoute;
---

<a href={siteTitleHref} class="wordmark" aria-label={siteTitle} translate="no">
  <span aria-hidden="true" class="square"></span><span>stubwise</span><span
    aria-hidden="true"
    class="cursor">_</span
  >
</a>

<style>
  .wordmark {
    display: inline-flex;
    align-items: baseline;
    font-family: "IBM Plex Mono", ui-monospace, "SF Mono", Menlo, monospace;
    font-weight: 600;
    font-size: var(--sl-text-h4);
    letter-spacing: -0.02em;
    color: var(--sl-color-white);
    text-decoration: none;
    white-space: nowrap;
    user-select: none;
  }

  .square {
    display: inline-block;
    width: 0.62em;
    height: 0.62em;
    margin-right: 0.5em;
    transform: translateY(1px);
    background: #f5a623;
  }

  .cursor {
    color: #f5a623;
    animation: blink 1.1s step-end infinite;
  }

  @keyframes blink {
    0%,
    60% {
      opacity: 1;
    }
    61%,
    100% {
      opacity: 0;
    }
  }

  /* Rispetta chi preferisce meno animazioni: cursore fisso e visibile. */
  @media (prefers-reduced-motion: reduce) {
    .cursor {
      animation: none;
    }
  }
</style>
