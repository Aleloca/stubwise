---
/**
 * Custom landing page rendered by the splash homepage (src/content/docs/index.mdx).
 *
 * Orchestrator: hero, platform overview, how-it-works, toolbox and outro live
 * here; the deep per-pillar sections live in ./landing/*.astro. All SHARED
 * primitives (.section, .term, .snippet, .callout, .kv, buttons, .t-* helpers…)
 * are defined here in a <style is:global> block nested under .sw-landing, so
 * child components can use them; each child keeps scoped styles only for its
 * own mock layout.
 *
 * Links are built from `import.meta.env.BASE_URL` because Astro-component
 * markup does NOT go through the rehype rebase plugin (that only rewrites
 * markdown/MDX content links).
 *
 * Narrative: the four verbs of the headline (documents, plans, fixes, watches)
 * are the four pillars of the platform — the page is structured around them,
 * not around the issue tracker alone.
 */
import "@fontsource/ibm-plex-mono/400.css";
import "@fontsource/ibm-plex-mono/500.css";
import "@fontsource/ibm-plex-mono/600.css";
import "@fontsource/ibm-plex-mono/700.css";
import DeepDocs from "./landing/DeepDocs.astro";
import DeepPlan from "./landing/DeepPlan.astro";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const l = (path: string) => `${base}/${path}`;
const GITHUB = "https://github.com/Aleloca/stubwise";

const features = [
  {
    k: "tickets",
    title: "Tickets & Kanban",
    desc: "A complete tracker: projects, board, comments, milestones, saved views, attachments.",
    href: l("getting-started/web-app/"),
  },
  {
    k: "sdk",
    title: "Error capture SDK",
    desc: "Browser and Node: unhandled errors become tickets, deduplicated by fingerprint. Plus feedback and API tickets.",
    href: l("sdk/installation/"),
  },
  {
    k: "widget",
    title: "Customer-service widget",
    desc: "An embeddable chat that answers from your docs and turns user reports into tickets.",
    href: l("integrations/widget/"),
  },
  {
    k: "review",
    title: "Automatic PR review",
    desc: "Every opened or updated pull request gets an AI review with a verdict and comments.",
    href: l("ai-pipeline/automation/"),
  },
  {
    k: "slack",
    title: "Slack",
    desc: "Open tickets with /stubwise or a message action, without leaving Slack.",
    href: l("integrations/slack/"),
  },
  {
    k: "hook",
    title: "Inbound webhook",
    desc: "Create tickets from any system with a single authenticated POST.",
    href: l("integrations/inbound-webhook/"),
  },
  {
    k: "notify",
    title: "Notifications",
    desc: "One outgoing webhook — Slack, Discord or JSON — on every event you care about.",
    href: l("notifications/"),
  },
  {
    k: "api",
    title: "HTTP API",
    desc: "An OpenAPI reference generated from the server's schemas, with personal access tokens.",
    href: l("reference/api/"),
  },
];
---

<div class="sw-landing">
  <!-- ============================== HERO ============================== -->
  <section class="hero">
    <div class="hero-copy">
      <p class="eyebrow reveal" style="--d: 0">
        <span class="dot dot-amber"></span> self-hosted
        <span class="sep">·</span>
        <span class="dot dot-green"></span> open source
        <span class="sep">·</span>
        <span class="dot dot-blue"></span> ai worker
      </p>
      <h2 class="headline reveal" style="--d: 1">
        Connect your repos.<br />
        Stubwise <span class="accent">documents</span>,
        <span class="accent">plans</span>,<br />
        <span class="accent">fixes</span> and <span class="accent">watches</span>
        them.
      </h2>
      <p class="tagline reveal" style="--d: 2">
        A self-hosted platform built around your repositories: AI-written docs
        and release notes, a backlog that talks to Claude Code, tickets that
        turn into pull requests, daily activity reports and server monitoring —
        on your infra, with your data.
      </p>
      <div class="cta-row reveal" style="--d: 3">
        <a class="btn btn-primary" href={l("getting-started/self-hosting/")}>
          Self-hosting in 5 minutes <span class="arrow" aria-hidden="true">→</span>
        </a>
        <a class="btn btn-ghost" href={l("integrations/claude-code-mcp/")}>Connect Claude Code</a>
      </div>
      <p class="meta-row reveal" style="--d: 4">
        MIT license <span class="sep">·</span> TypeScript end-to-end
        <span class="sep">·</span>
        <a href={GITHUB}>github.com/Aleloca/stubwise ↗</a>
      </p>
    </div>

    <div class="hero-term reveal" style="--d: 2" aria-hidden="true">
      <div class="term">
        <div class="term-bar">
          <span class="tl tl-red"></span>
          <span class="tl tl-yellow"></span>
          <span class="tl tl-green"></span>
          <span class="term-title">stubwise · worker</span>
        </div>
        <div class="term-body">
          <p class="tline" style="--i: 0">
            <span class="t-dim">$</span> tail -f worker.log
          </p>
          <p class="tline" style="--i: 1">
            <span class="t-blue">⚙</span> docs
            <span class="t-dim">·</span> apps/server changed
            <span class="t-dim">→</span> 5 pages refreshed
          </p>
          <p class="tline" style="--i: 2">
            <span class="t-blue">⚙</span> releases
            <span class="t-dim">·</span> v1.4.2 notes drafted
            <span class="t-dim">from 18 commits</span>
          </p>
          <p class="tline" style="--i: 3">
            <span class="t-blue">⚙</span> backlog
            <span class="t-dim">·</span> 3 feedback tickets
            <span class="t-dim">→</span> 1 item
          </p>
          <p class="tline" style="--i: 4">
            <span class="t-blue">⚙</span> activity
            <span class="t-dim">·</span> daily report: 34 commits, 3 devs
          </p>
          <p class="tline" style="--i: 5">
            <span class="t-green">✓</span> fix <span class="t-bold">#142</span>
            <span class="t-dim">·</span> tests green
            <span class="t-dim">→</span> PR <span class="t-bold">#87</span>
            <span class="t-amber">↗</span>
          </p>
          <p class="tline" style="--i: 6">
            <span class="t-amber">●</span> queue idle
            <span class="t-dim">— watching your repos</span>
          </p>
          <p class="tline" style="--i: 7">
            <span class="t-dim">$</span><span class="t-cursor">_</span>
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================ PILLARS ============================= -->
  <section class="section">
    <p class="section-eyebrow"><span class="t-dim">&gt;</span> the platform <span class="t-dim">[01/09]</span></p>
    <h3 class="section-title">One worker, four jobs.</h3>
    <div class="pillars">
      <article class="pillar">
        <p class="pillar-index"><a href="#document">01 · document</a></p>
        <h4>Living docs</h4>
        <p>
          <a href={l("documentation/autogenerated/")}>Autogenerated documentation</a>
          per repository, refreshed on every push, plus dated release notes and
          a RAG chat over docs and code.
        </p>
      </article>
      <article class="pillar">
        <p class="pillar-index"><a href="#plan">02 · plan</a></p>
        <h4>Backlog</h4>
        <p>
          User feedback distilled into a
          <a href={l("team/backlog/")}>deduplicated backlog</a>, refined in
          chat and synced with your editor via
          <a href={l("integrations/claude-code-mcp/")}>Claude Code (MCP)</a>.
        </p>
      </article>
      <article class="pillar">
        <p class="pillar-index"><a href="#fix">03 · fix</a></p>
        <h4>Auto-fix</h4>
        <p>
          Tickets from SDK, widget or Slack; the
          <a href={l("ai-pipeline/how-it-works/")}>AI pipeline</a> triages them
          and proposes the fix as a pull request a human merges.
        </p>
      </article>
      <article class="pillar">
        <p class="pillar-index"><a href="#watch">04 · watch</a></p>
        <h4>Awareness</h4>
        <p>
          Daily <a href={l("team/activity/")}>AI activity reports</a> from your
          commits, <a href={l("monitoring/")}>server monitoring</a> with a push
          agent, and <a href={l("notifications/")}>notifications</a> on what
          matters.
        </p>
      </article>
    </div>
    <p class="section-note">
      Everything is an <strong>opt-in toggle</strong> per project or repository
      — enable only what you need. Without authenticating the AI, Stubwise
      stays a complete self-hosted issue tracker.
    </p>
  </section>

  <DeepDocs />
  <DeepPlan />

  <!-- ============================ IN DEPTH ============================ -->
  <section class="section">
    <p class="section-eyebrow"><span class="t-dim">&gt;</span> in depth <span class="t-dim">[02/05]</span></p>
    <h3 class="section-title">The flows you'll live in.</h3>

    <div class="dives">
      <article class="step step-wide">
        <div class="step-text">
          <p class="step-index">document</p>
          <h4>Documentation that keeps itself up to date</h4>
          <p>
            Every connected repo gets a Confluence-like Docs space: technical,
            functional and product pages written by the worker, refreshed
            incrementally on every push. Release notes become a dated
            changelog. Vector search and a RAG chat answer from docs and code,
            grounded by the <a href={l("documentation/code-graph/")}>knowledge
            graph</a> — with local embeddings, nothing leaves your server.
          </p>
          <a class="step-link" href={l("documentation/autogenerated/")}>Autogenerated docs →</a>
        </div>
        <div class="snippet" data-lang="on git push">
          <pre><code><span class="t-dim">push →</span> main <span class="t-dim">@</span> a3f9c2
<span class="t-blue">⚙</span> docs · 3 areas changed <span class="t-dim">→</span> 5 pages refreshed
<span class="t-blue">⚙</span> releases · v1.4.2 entry drafted
<span class="t-green">✓</span> published <span class="t-dim">— searchable, chattable</span></code></pre>
        </div>
      </article>

      <article class="step step-wide">
        <div class="step-text">
          <p class="step-index">plan</p>
          <h4>A backlog that talks to your editor</h4>
          <p>
            Feedback and feature requests are distilled into deduplicated
            backlog items. Refine them in a chat that can read the repo, then
            keep working from your editor: the <code>@stubwise/mcp</code>
            server lets Claude Code consult the backlog, attach designs and
            implementation plans, convert items into tickets and advance their
            status while you code.
          </p>
          <a class="step-link" href={l("team/backlog/")}>Backlog discovery →</a>
          <a class="step-link" href={l("integrations/claude-code-mcp/")}>Claude Code integration →</a>
        </div>
        <div class="snippet" data-lang="claude code">
          <pre><code><span class="t-dim">&gt;</span> /stubwise:start
<span class="t-green">✓</span> item <span class="t-amber">"bulk CSV export"</span> <span class="t-dim">→</span> ticket <span class="t-bold">#218</span>
<span class="t-green">✓</span> design + plan attached from the session
<span class="t-blue">⚙</span> status <span class="t-dim">→</span> in_progress</code></pre>
        </div>
      </article>
    </div>
  </section>

  <!-- ========================== HOW IT WORKS ========================== -->
  <section class="section">
    <p class="section-eyebrow"><span class="t-dim">&gt;</span> how it works <span class="t-dim">[03/05]</span></p>
    <h3 class="section-title">Install → connect → enable.</h3>

    <div class="steps">
      <article class="step step-wide">
        <div class="step-text">
          <p class="step-index">step 01</p>
          <h4>Self-host the stack</h4>
          <p>
            One Docker Compose file: Postgres, the API server, the AI worker,
            local embeddings and Caddy with automatic HTTPS. Migrations apply
            themselves on startup.
          </p>
          <a class="step-link" href={l("getting-started/self-hosting/")}>Read the self-hosting guide →</a>
        </div>
        <div class="snippet" data-lang="sh">
          <button class="copy" data-copy={`git clone ${GITHUB}.git\ncd stubwise && cp .env.example .env\ndocker compose up -d --build`} aria-label="Copy commands">copy</button>
          <pre><code><span class="t-dim">$</span> git clone {GITHUB}.git
<span class="t-dim">$</span> cd stubwise <span class="t-amber">&&</span> cp .env.example .env
<span class="t-dim">$</span> docker compose up -d --build</code></pre>
        </div>
      </article>

      <article class="step">
        <p class="step-index">step 02</p>
        <h4>Connect repos &amp; apps</h4>
        <p>
          Link your GitHub or Bitbucket repositories — the worker keeps local
          mirrors and opens PRs with your credentials. Then one
          <code>init()</code> in your app turns unhandled errors into tickets.
        </p>
        <div class="snippet" data-lang="js">
          <button class="copy" data-copy={`import { init } from "@stubwise/sdk/browser";\n\ninit({ dsn: "https://KEY@your-host/p/app" });`} aria-label="Copy snippet">copy</button>
          <pre><code><span class="t-blue">import</span> {"{ init }"} <span class="t-blue">from</span> <span class="t-green">"@stubwise/sdk/browser"</span>;

<span class="t-fn">init</span>({"{"} dsn: <span class="t-green">"https://KEY@your-host/p/app"</span> {"}"});</code></pre>
        </div>
        <a class="step-link" href={l("sdk/installation/")}>SDK installation →</a>
      </article>

      <article class="step">
        <p class="step-index">step 03</p>
        <h4>Enable what you need</h4>
        <p>
          Docs generation, backlog discovery, activity reports, monitoring,
          auto-fix, PR review: every capability is a per-project or
          per-repository toggle. Authenticate the AI worker with an API key or
          a subscription login — it runs on your credentials, on your machine.
        </p>
        <a class="step-link" href={l("getting-started/claude-setup/")}>Worker auth →</a>
        <a class="step-link" href={l("reference/configuration/")}>Configuration reference →</a>
      </article>
    </div>
  </section>

  <!-- ============================ FEATURES ============================ -->
  <section class="section">
    <p class="section-eyebrow"><span class="t-dim">&gt;</span> also in the box <span class="t-dim">[04/05]</span></p>
    <h3 class="section-title">The rest of the toolbox.</h3>
    <div class="grid">
      {
        features.map((f) => (
          <a class="cell" href={f.href}>
            <p class="cell-key">[{f.k}]</p>
            <h4>{f.title}</h4>
            <p class="cell-desc">{f.desc}</p>
          </a>
        ))
      }
    </div>
    <p class="section-note">
      Plus: milestones, saved views, S3-compatible attachments, AI usage
      dashboards, a provider chain with failover, and an English/Italian UI.
    </p>
  </section>

  <!-- ============================== CTA =============================== -->
  <section class="section outro">
    <p class="section-eyebrow"><span class="t-dim">&gt;</span> get started <span class="t-dim">[05/05]</span></p>
    <h3 class="outro-title">
      Your repos. Your data.<br />
      <span class="accent">Your rules.</span>
    </h3>
    <div class="cta-row">
      <a class="btn btn-primary" href={l("getting-started/self-hosting/")}>
        Self-hosting in 5 minutes <span class="arrow" aria-hidden="true">→</span>
      </a>
      <a class="btn btn-ghost" href={GITHUB}>Star on GitHub ↗</a>
    </div>
  </section>
</div>

<script>
  // Copy buttons: delegate one listener for the whole landing.
  document.addEventListener("click", (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>("button.copy");
    if (!btn?.dataset.copy) return;
    navigator.clipboard.writeText(btn.dataset.copy).then(() => {
      btn.classList.add("copied");
      btn.textContent = "copied";
      setTimeout(() => {
        btn.classList.remove("copied");
        btn.textContent = "copy";
      }, 1600);
    });
  });

  // Scroll reveal for .rise elements. Progressive enhancement: the hidden
  // state only applies once .js-anim is set, so without JS (or with reduced
  // motion) everything stays visible.
  const root = document.querySelector(".sw-landing");
  if (root && !window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
    root.classList.add("js-anim");
    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.classList.add("in");
            io.unobserve(entry.target);
          }
        }
      },
      { threshold: 0.1 },
    );
    root.querySelectorAll(".rise").forEach((el) => io.observe(el));
  }
</script>

<style is:global>
  /* ==================== page-frame overrides ==================== */
  /* Let the landing own the full content column of the splash page: drop the
     prose max-width and paddings, hide the auto-injected frontmatter <h1>
     (kept in the DOM for the accessibility tree / document outline). */
  .sl-markdown-content:has(.sw-landing) {
    margin-top: 0 !important;
  }
  main:has(.sw-landing) .content-panel {
    padding: 0;
    border: 0;
  }
  /* Full-bleed: the landing paints its own textured background, so it must
     span the whole main column — otherwise its edge shows as a seam against
     the page background. Inner sections keep their own centered max-width. */
  main:has(.sw-landing) .sl-container {
    max-width: none;
    margin-inline: 0;
  }
  main:has(.sw-landing) h1#_top {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
  }
  /* Landing-tuned page chrome: slightly deeper page background than the
     Starlight default, in both themes. */
  :root:has(.sw-landing) {
    --sl-color-bg: #0b0c10;
  }
  :root[data-theme="light"]:has(.sw-landing) {
    --sl-color-bg: #f7f6f1;
  }

  @keyframes sw-tline-in {
    to {
      opacity: 1;
      transform: none;
    }
  }
  @keyframes sw-blink {
    0%,
    60% {
      opacity: 1;
    }
    61%,
    100% {
      opacity: 0;
    }
  }
  @keyframes sw-reveal-in {
    to {
      opacity: 1;
      transform: none;
    }
  }

  /* ================== shared landing primitives ================== */
  /* Everything is nested under .sw-landing so child components in
     ./landing/*.astro can use the same classes without scoping issues. */
  .sw-landing {
    --mono: "IBM Plex Mono", ui-monospace, "SF Mono", Menlo, monospace;
    --amber: #f5a623;
    --green: #3ecf8e;
    --blue: #6cb2ff;
    --red: #ff6b61;
    --bg: #0b0c10;
    --panel: #101218;
    --panel-2: #0d0f14;
    --border: #23262e;
    --text: #e9eaee;
    --dim: #99a0ac;
    --term-bg: #0a0c11;
    --shadow: 0 24px 60px -24px rgb(0 0 0 / 0.7);
    font-family: var(--mono);
    color: var(--text);
    background:
      radial-gradient(52rem 30rem at 82% -6rem, rgb(245 166 35 / 0.07), transparent 60%),
      repeating-linear-gradient(0deg, rgb(255 255 255 / 0.014) 0 1px, transparent 1px 3px),
      var(--bg);
    line-height: 1.6;
    overflow: hidden;

    .accent {
      color: var(--amber);
    }
    a {
      color: var(--amber);
      text-decoration: none;
    }
    a:hover {
      text-decoration: underline;
      text-underline-offset: 0.25em;
    }

    /* ---------------------------- hero ---------------------------- */
    .hero {
      display: grid;
      grid-template-columns: minmax(0, 1.12fr) minmax(0, 0.88fr);
      gap: 3rem;
      align-items: center;
      max-width: 72rem;
      margin: 0 auto;
      padding: 5.5rem 1.5rem 5rem;
    }
    .eyebrow {
      margin: 0 0 1.25rem;
      font-size: 0.78rem;
      font-weight: 500;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      color: var(--dim);
    }
    .dot {
      display: inline-block;
      width: 0.45em;
      height: 0.45em;
      border-radius: 50%;
      margin-right: 0.45em;
      transform: translateY(-0.08em);
    }
    .dot-amber {
      background: var(--amber);
    }
    .dot-green {
      background: var(--green);
    }
    .dot-blue {
      background: var(--blue);
    }
    .sep {
      margin: 0 0.55em;
      color: var(--border);
    }
    .headline {
      margin: 0 0 1.4rem;
      font-family: var(--mono);
      font-weight: 700;
      font-size: clamp(1.75rem, 3.1vw, 2.35rem);
      line-height: 1.18;
      letter-spacing: -0.04em;
      color: var(--text);
    }
    .tagline {
      margin: 0 0 2rem;
      max-width: 36rem;
      font-size: 0.98rem;
      color: var(--dim);
    }
    .cta-row {
      display: flex;
      flex-wrap: wrap;
      gap: 0.8rem;
      align-items: center;
    }
    .btn {
      display: inline-flex;
      align-items: center;
      gap: 0.5em;
      padding: 0.72em 1.25em;
      font-family: var(--mono);
      font-weight: 600;
      font-size: 0.88rem;
      border: 1px solid transparent;
      transition:
        transform 0.15s ease,
        box-shadow 0.15s ease,
        border-color 0.15s ease,
        background 0.15s ease;
    }
    .btn-primary {
      background: var(--amber);
      color: #16130a;
      box-shadow: 0 8px 24px -10px rgb(245 166 35 / 0.55);
    }
    .btn-primary:hover {
      text-decoration: none;
      transform: translateY(-1px);
      box-shadow: 0 12px 28px -10px rgb(245 166 35 / 0.7);
    }
    .btn-primary .arrow {
      transition: transform 0.15s ease;
    }
    .btn-primary:hover .arrow {
      transform: translateX(3px);
    }
    .btn-ghost {
      color: var(--text);
      border-color: var(--border);
      background: transparent;
    }
    .btn-ghost:hover {
      text-decoration: none;
      border-color: var(--amber);
      color: var(--amber);
    }
    .meta-row {
      margin: 1.6rem 0 0;
      font-size: 0.78rem;
      color: var(--dim);
    }
    .meta-row a {
      white-space: nowrap;
    }

    /* ----------------------- terminal chrome ----------------------- */
    .term {
      background: var(--term-bg);
      border: 1px solid var(--border);
      border-radius: 10px;
      box-shadow: var(--shadow);
      overflow: hidden;
    }
    .term-bar {
      display: flex;
      align-items: center;
      gap: 0.45rem;
      padding: 0.6rem 0.9rem;
      border-bottom: 1px solid #1c1f27;
      background: #0e1016;
    }
    .tl {
      width: 0.68em;
      height: 0.68em;
      border-radius: 50%;
    }
    .tl-red {
      background: #ff5f56;
    }
    .tl-yellow {
      background: #ffbd2e;
    }
    .tl-green {
      background: #27c93f;
    }
    .term-title {
      margin-left: 0.6rem;
      font-size: 0.72rem;
      letter-spacing: 0.12em;
      color: #8a90a0;
    }
    .term-body {
      padding: 1.1rem 1.2rem 1.2rem;
      font-size: 0.8rem;
      line-height: 1.9;
    }
    .tline {
      margin: 0;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
