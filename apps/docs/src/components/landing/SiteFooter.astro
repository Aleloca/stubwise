---
/**
 * Landing footer, graphify-style: brand + link columns + bottom bar. Rendered
 * inside .sw-landing so it inherits the landing tokens (light/dark included).
 */
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const l = (path: string) => `${base}/${path}`;
const GITHUB = "https://github.com/Aleloca/stubwise";

const columns = [
  {
    title: "Platform",
    links: [
      { label: "Document", href: "#document" },
      { label: "Plan", href: "#plan" },
      { label: "Capture", href: "#capture" },
      { label: "Track", href: "#track" },
      { label: "Fix", href: "#fix" },
      { label: "Review", href: "#review" },
      { label: "Support", href: "#support" },
      { label: "Report", href: "#report" },
      { label: "Monitor", href: "#monitor" },
    ],
  },
  {
    title: "Developers",
    links: [
      { label: "Self-hosting", href: l("getting-started/self-hosting/") },
      { label: "Worker auth", href: l("getting-started/claude-setup/") },
      { label: "SDK", href: l("sdk/installation/") },
      { label: "HTTP API", href: l("reference/api/") },
      { label: "Configuration", href: l("reference/configuration/") },
      { label: "GitHub ↗", href: GITHUB },
    ],
  },
  {
    title: "Integrations",
    links: [
      { label: "Claude Code (MCP)", href: l("integrations/claude-code-mcp/") },
      { label: "Slack", href: l("integrations/slack/") },
      { label: "Widget", href: l("integrations/widget/") },
      { label: "Inbound webhook", href: l("integrations/inbound-webhook/") },
      { label: "Notifications", href: l("notifications/") },
    ],
  },
  {
    title: "Guides",
    links: [
      { label: "Autogenerated docs", href: l("documentation/autogenerated/") },
      { label: "Code graph", href: l("documentation/code-graph/") },
      { label: "Backlog discovery", href: l("team/backlog/") },
      { label: "Activity reports", href: l("team/activity/") },
      { label: "Server monitoring", href: l("monitoring/") },
      { label: "Security", href: l("ai-pipeline/security/") },
    ],
  },
];
---

<footer class="swfooter">
  <div class="swf-inner">
    <div class="swf-grid">
      <div class="swf-brand">
        <p class="swf-mark" translate="no">
          <span class="swf-square" aria-hidden="true"></span>stubwise<span
            class="swf-cursor"
            aria-hidden="true">_</span
          >
        </p>
        <p class="swf-tag">
          The self-hosted platform that documents, plans, fixes and watches
          your repositories.
        </p>
        <p class="swf-chips">
          <span class="chip">MIT license</span>
          <span class="chip">self-hosted</span>
          <span class="chip">TypeScript</span>
        </p>
      </div>
      {
        columns.map((col) => (
          <div class="swf-col">
            <p class="swf-h">{col.title}</p>
            {col.links.map((link) => (
              <a href={link.href}>{link.label}</a>
            ))}
          </div>
        ))
      }
    </div>
    <div class="swf-bottom">
      <p>© 2026 Stubwise contributors · MIT license</p>
      <p><span class="dot dot-amber"></span> your servers · your data · your rules</p>
    </div>
  </div>
</footer>

<style>
  .swfooter {
    border-top: 1px solid var(--border);
    background: var(--panel-2);
  }
  .swf-inner {
    max-width: 72rem;
    margin: 0 auto;
    padding: 3.5rem 1.5rem 2rem;
  }
  .swf-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) repeat(4, minmax(0, 1fr));
    gap: 2.2rem;
  }
  .swf-mark {
    margin: 0 0 0.8rem;
    font-weight: 600;
    font-size: 1.05rem;
    letter-spacing: -0.02em;
    color: var(--text);
    user-select: none;
  }
  .swf-square {
    display: inline-block;
    width: 0.62em;
    height: 0.62em;
    margin-right: 0.5em;
    transform: translateY(1px);
    background: var(--amber);
  }
  .swf-cursor {
    color: var(--amber);
  }
  .swf-tag {
    margin: 0 0 1rem;
    max-width: 20rem;
    font-size: 0.8rem;
    line-height: 1.65;
    color: var(--dim);
  }
  .swf-chips {
    margin: 0;
  }
  .swf-h {
    margin: 0 0 0.8rem;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--dim);
  }
  .swf-col a {
    display: block;
    margin-bottom: 0.5rem;
    font-size: 0.8rem;
    color: var(--text);
    text-decoration: none;
    opacity: 0.85;
  }
  .swf-col a:hover {
    color: var(--amber);
    opacity: 1;
    text-decoration: none;
  }
  .swf-bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.8rem;
    margin-top: 3rem;
    padding-top: 1.2rem;
    border-top: 1px solid var(--border);
  }
  .swf-bottom p {
    margin: 0;
    font-size: 0.74rem;
    color: var(--dim);
  }

  @media (max-width: 60rem) {
    .swf-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .swf-brand {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 38rem) {
    .swf-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
