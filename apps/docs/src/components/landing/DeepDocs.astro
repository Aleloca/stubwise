---
/**
 * Deep section: DOCUMENT. A reconstructed Docs-space UI (sidebar tree, page,
 * grounded chat) with annotation callouts. Shared landing primitives
 * (.section, .term, .callout, .kv…) come from Landing.astro's global styles;
 * only the mock-specific layout lives here.
 */
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const l = (path: string) => `${base}/${path}`;
---

<section class="section" id="document">
  <p class="section-eyebrow"><span class="t-dim">&gt;</span> document <span class="t-dim">[02/09]</span></p>
  <h3 class="section-title rise">Docs that write themselves.</h3>
  <p class="lead rise">
    Connect a repository and the worker maps it into a Confluence-like Docs
    space: <strong>technical</strong> pages for engineers,
    <strong>functional</strong> pages for the team, <strong>product</strong>
    guides for your users. On every push only the pages whose source files
    changed are rewritten — and the push itself lands as a dated release-notes
    entry.
  </p>

  <div class="mockwrap rise">
    <div class="term mock-docs" aria-hidden="true">
      <div class="term-bar">
        <span class="tl tl-red"></span><span class="tl tl-yellow"></span><span class="tl tl-green"></span>
        <span class="term-title">stubwise · /docs/acme-api</span>
      </div>
      <div class="docs-body">
        <div class="docs-tree">
          <p class="tree-head">▾ acme-api</p>
          <p class="tree-item">Overview</p>
          <p class="tree-item active">Payments service</p>
          <p class="tree-item">▸ API</p>
          <p class="tree-item">▸ Guides <span class="t-dim">product</span></p>
          <p class="tree-head tree-rel">▾ releases</p>
          <p class="tree-item"><span class="t-dim">Aug 4</span> v1.4.2</p>
          <p class="tree-item"><span class="t-dim">Jul 29</span> v1.4.1</p>
        </div>
        <div class="docs-page">
          <p class="page-title">Payments service</p>
          <p class="page-meta">
            <span class="chip chip-blue">technical</span>
            <span class="t-dim">updated 2h ago · source: apps/server/src/payments</span>
          </p>
          <p class="page-prose">
            Charges are created by <span class="t-amber">createCharge()</span>
            and reconciled by the webhook consumer. Refunds go through the same
            idempotency guard…
          </p>
          <div class="docs-chat">
            <p class="chat-q"><span class="t-dim">you ·</span> Where are refunds handled?</p>
            <p class="chat-a">
              <span class="t-dim">chat ·</span> In the webhook consumer, behind
              the idempotency guard.
              <span class="chip">payments.ts:88</span>
              <span class="chip">Payments service</span>
            </p>
          </div>
        </div>
      </div>
    </div>
    <p class="callout" style="top: 10%; right: -1rem">
      <span class="callout-k">on push</span>
      Only pages whose source paths are in the diff get rewritten — the rest is
      left alone.
    </p>
    <p class="callout" style="bottom: 24%; left: -1rem">
      <span class="callout-k">release notes</span>
      Every push becomes a dated changelog entry in RELEASES.
    </p>
    <p class="callout" style="bottom: -1.4rem; right: 6%">
      <span class="callout-k">grounded chat</span>
      RAG over docs and code, enriched by the knowledge graph. Embeddings are
      local (Ollama, bge-m3).
    </p>
  </div>

  <div class="kv rise">
    <div class="kv-row">
      <p class="kv-k">Three classes</p>
      <p class="kv-v">
        Technical, functional and product pages, generated per surface with
        their own page budgets.
      </p>
    </div>
    <div class="kv-row">
      <p class="kv-k">Secret verifier</p>
      <p class="kv-v">
        Public product pages pass a fail-closed audit before publishing —
        anything that looks like a secret is rewritten or excluded.
      </p>
    </div>
    <div class="kv-row">
      <p class="kv-k">Nothing leaves</p>
      <p class="kv-v">
        pgvector + Ollama on your host: vector search and chat run entirely on
        the box.
      </p>
    </div>
  </div>

  <p class="rise">
    <a class="step-link" href={l("documentation/autogenerated/")}>Autogenerated docs →</a>
    <a class="step-link" href={l("documentation/code-graph/")}>Code graph →</a>
  </p>
</section>

<style>
  .mock-docs {
    max-width: 54rem;
  }
  .docs-body {
    display: grid;
    grid-template-columns: 13rem minmax(0, 1fr);
    font-size: 0.8rem;
    line-height: 1.85;
  }
  .docs-tree {
    padding: 1rem 1.1rem;
    border-right: 1px solid #1c1f27;
    color: #aab0bc;
  }
  .docs-tree p {
    margin: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .tree-head {
    color: #6b7284;
    letter-spacing: 0.08em;
    font-size: 0.7rem;
    text-transform: uppercase;
  }
  .tree-rel {
    margin-top: 0.7rem !important;
  }
  .tree-item {
    padding-left: 0.9rem;
  }
  .tree-item.active {
    color: var(--amber);
  }
  .docs-page {
    padding: 1rem 1.3rem 1.2rem;
    min-width: 0;
  }
  .docs-page p {
    margin: 0 0 0.5rem;
  }
  .page-title {
    font-size: 1rem;
    font-weight: 700;
    color: #e9eaee;
  }
  .page-meta {
    font-size: 0.72rem;
    color: #8a90a0;
  }
  .page-prose {
    color: #c6cad3;
    max-width: 34rem;
  }
  .docs-chat {
    margin-top: 1rem;
    padding: 0.8rem 1rem;
    border: 1px solid #23262e;
    border-radius: 8px;
    background: #0e1016;
  }
  .docs-chat p {
    margin: 0 0 0.35rem;
    color: #dfe2e9;
  }
  .docs-chat p:last-child {
    margin-bottom: 0;
  }
  .chat-a {
    color: #c6cad3;
  }

  @media (max-width: 38rem) {
    .docs-body {
      grid-template-columns: 1fr;
    }
    .docs-tree {
      display: none;
    }
  }
</style>
