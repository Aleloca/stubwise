{
  "name": "@stubwise/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./app": "./src/app.ts"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "backfill:ticket-events": "tsx scripts/backfill-ticket-done-events.ts",
    "build": "tsc -p tsconfig.build.json && tsc -p tsconfig.scripts-build.json",
    "test": "pnpm --filter @stubwise/sdk... --filter @stubwise/db... --filter @stubwise/embeddings... --filter @stubwise/notifications... --filter @stubwise/agent... build && vitest run",
    "typecheck": "tsc --noEmit && tsc -p scripts/tsconfig.json"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.105.0",
    "@aws-sdk/client-s3": "^3.1069.0",
    "@aws-sdk/s3-request-presigner": "^3.1069.0",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.2.0",
    "@fastify/multipart": "^9.0.3",
    "@fastify/rate-limit": "^11.0.0",
    "@fastify/swagger": "^9.7.0",
    "@modelcontextprotocol/sdk": "^1.20.0",
    "@stubwise/db": "workspace:*",
    "@stubwise/embeddings": "workspace:*",
    "@stubwise/git": "workspace:*",
    "@stubwise/i18n": "workspace:*",
    "@stubwise/notifications": "workspace:*",
    "@stubwise/shared": "workspace:*",
    "argon2": "^0.44.0",
    "drizzle-orm": "^0.45.2",
    "execa": "^9.5.0",
    "fastify": "^5.0.0",
    "fastify-type-provider-zod": "^6.1.0",
    "fflate": "^0.8.3",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@stubwise/agent": "workspace:*",
    "@stubwise/sdk": "workspace:*",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^3.2.0"
  }
}
