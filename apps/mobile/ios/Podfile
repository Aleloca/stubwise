# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, min_ios_version_supported
prepare_react_native_project!

# Task 19 (push): RN >= 0.75 risolve le dipendenze iOS di Firebase via Swift
# Package Manager di default, che a sua volta richiede `use_frameworks!
# :linkage => :dynamic` — un cambio invasivo (linking dinamico per TUTTI i pod,
# non solo Firebase, con implicazioni sugli altri moduli nativi già in uso:
# keychain, notifee, netinfo…). Questo flag tiene invece Firebase sulla stessa
# strada CocoaPods statica del resto del progetto: nessun'altra riga del
# Podfile cambia comportamento. Documentato da
# `@react-native-firebase/app` (README, sezione "iOS Dependency Resolution").
$RNFirebaseDisableSPM = true

# I pod Swift di Firebase (FirebaseCoreInternal → GoogleUtilities) non si
# integrano come librerie statiche "nude": CocoaPods lo rifiuta con «The
# following Swift pods cannot yet be integrated as static libraries». La
# strada documentata da @react-native-firebase per la modalità CocoaPods è
# `use_frameworks! :linkage => :static` (framework, ma statici: nessun dylib
# embeddato, tutto resta linkato staticamente come prima) più
# `$RNFirebaseAsStaticFramework = true`, che dice a RNFBApp di dichiararsi
# static_framework. `USE_FRAMEWORKS=dynamic` in env resta possibile per chi
# volesse provare il linking dinamico; il default è `static`.
$RNFirebaseAsStaticFramework = true

linkage = ENV['USE_FRAMEWORKS'] || 'static'
Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
use_frameworks! :linkage => linkage.to_sym

target 'StubwiseMobile' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )

    # Fix post-merge PR #21 (app M2, 11 set 2026): il main non compilava per
    # iOS — nessuna build nativa gira in CI, quindi la CI verde di quella PR
    # non copre questo caso (vedi apps/mobile/README.md, sezione "Verifica
    # manuale sul telefono"). `react-native-bottom-tabs` importa
    # `#import "RCTConversions.h"` fra virgolette (import relativo), ma
    # questo Podfile usa `use_frameworks! :linkage => :static` (righe sopra,
    # obbligatorio per Firebase) — e con quel linkage l'header di React-Core
    # vive DENTRO `React.framework/Headers`, raggiungibile solo come
    # `<React/RCTConversions.h>`, non con un percorso relativo. Errore senza
    # questo fix: `fatal error: 'RCTConversions.h' file not found` in
    # `RCTTabViewComponentView.mm:21`.
    #
    # ⚠️ FRAGILE, di proposito segnalato: il percorso qui sotto
    # (`React.xcframework/ios-arm64/...`) è un dettaglio INTERNO del
    # framework prebuilt di React Native 0.87, non un'API pubblica — un
    # aggiornamento di React Native che cambi come React-Core-prebuilt
    # organizza i suoi header (o l'architettura del device, es. build per
    # simulatore invece di device fisico: qui è cablato `ios-arm64`) può
    # rompere silenziosamente questo hook senza toccare nessun'altra riga
    # del progetto. Se un aggiornamento di RN o `react-native-bottom-tabs`
    # smette di compilare con lo stesso errore, guarda qui per primo prima
    # di rincollare lo stesso fix: la strada alternativa valutata è sostituire
    # `react-native-bottom-tabs` con una tab bar disegnata in JS (vedi
    # `@callstack/liquid-glass`, usato da un altro progetto dello stesso
    # maintainer proprio per evitare questa classe di problema).
    installer.pods_project.targets.each do |t|
      next unless t.name == 'react-native-bottom-tabs'
      t.build_configurations.each do |cfg|
        cfg.build_settings['HEADER_SEARCH_PATHS'] ||= '$(inherited)'
        cfg.build_settings['HEADER_SEARCH_PATHS'] = [
          cfg.build_settings['HEADER_SEARCH_PATHS'],
          '"$(PODS_ROOT)/React-Core-prebuilt/React.xcframework/ios-arm64/React.framework/Headers"',
          '"$(PODS_ROOT)/React-RCTFabric"',
        ].join(' ')
      end
    end
  end
end
