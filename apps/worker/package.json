{
  "name": "@stubwise/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.build.json",
    "test": "pnpm --filter @stubwise/db... --filter @stubwise/git... --filter @stubwise/notifications... build && vitest run",
    "smoke": "tsx scripts/smoke.ts",
    "typecheck": "tsc --noEmit && tsc -p scripts/tsconfig.json"
  },
  "dependencies": {
    "@stubwise/db": "workspace:*",
    "@stubwise/git": "workspace:*",
    "@stubwise/notifications": "workspace:*",
    "@stubwise/shared": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "execa": "^9.5.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.0.1",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^3.2.0"
  }
}
