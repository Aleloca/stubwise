{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "resolveJsonModule": true,
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "types": ["vite/client"],
    // Il tipo del punto di scambio è quello del finto (`vite.backend.ts`
    // risolve davvero il modulo per la build).
    "paths": {
      "@backend/api": ["./src/renderer/data/api.ts"],
      "@backend/clock": ["./src/renderer/data/seed/dates.ts"],
      "@backend/access": ["./src/renderer/data/accessFacts.ts"],
      "@backend/runtime": ["./src/renderer/data/runtime.ts"],
      "@backend/viewer": ["./src/renderer/data/viewer.ts"]
    }
  },
  "include": ["src/renderer", "vitest.config.ts"]
}
