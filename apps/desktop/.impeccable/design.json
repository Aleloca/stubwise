    },
    {
      "name": "Notification Item",
      "kind": "custom",
      "refersTo": "notifications-panel",
      "description": "Unread ink dot, code, time, title, two-line body.",
      "html": "<div class=\"ds-ni\"><span class=\"ds-ud\"></span><span><span class=\"ds-nc\">AUD-142</span> <span class=\"ds-nt\">2m</span><span class=\"ds-nh\">Quote approved by client</span><span class=\"ds-nb\">Marta confirmed the revised terms.</span></span></div>",
      "css": ":host{--ground:oklch(0.185 0.004 265);--surface:oklch(0.215 0.004 265);--rail:oklch(0.16 0.004 265);--ink:oklch(0.965 0.006 85);--ink-muted:oklch(0.76 0.006 265);--ink-faint:oklch(0.64 0.006 265);--rule:oklch(0.965 0.006 85 / 0.11);--rule-strong:oklch(0.965 0.006 85 / 0.2);--focus:oklch(0.74 0.13 250);--dept-4:oklch(0.68 0.18 32);}.ds-ni{display:flex;gap:12px;padding:10px 16px;border-bottom:1px solid var(--rule);background:var(--surface);color:var(--ink);font-family:'Archivo Variable',ui-sans-serif,system-ui,sans-serif;}.ds-ud{margin-top:6px;width:8px;height:8px;border-radius:9999px;background:var(--ink);flex:none}.ds-nc{font-size:13px;font-weight:600;font-variant-numeric:tabular-nums}.ds-nt{font-size:12px;color:var(--ink-muted);margin-left:8px}.ds-nh{display:block;margin-top:2px;font-size:14px;font-weight:600}.ds-nb{display:block;font-size:13px;color:var(--ink-muted)}"
    },
    {
      "name": "Command Palette",
      "kind": "custom",
      "refersTo": "command-palette",
      "description": "Floating dialog: 12px radius, rule-strong border, soft shadow, group headings.",
      "html": "<div class=\"ds-pal\"><div class=\"ds-pi\">Search tasks, pages, people</div><div class=\"ds-pg\">Tasks</div><div class=\"ds-pr\"><b>AUD-142</b> Send revised quote</div></div>",
      "css": ":host{--ground:oklch(0.185 0.004 265);--surface:oklch(0.215 0.004 265);--rail:oklch(0.16 0.004 265);--ink:oklch(0.965 0.006 85);--ink-muted:oklch(0.76 0.006 265);--ink-faint:oklch(0.64 0.006 265);--rule:oklch(0.965 0.006 85 / 0.11);--rule-strong:oklch(0.965 0.006 85 / 0.2);--focus:oklch(0.74 0.13 250);--dept-4:oklch(0.68 0.18 32);}.ds-pal{width:420px;border-radius:12px;border:1px solid var(--rule-strong);background:var(--surface);color:var(--ink);box-shadow:0 24px 48px -16px oklch(0 0 0 / .45);overflow:hidden;font-family:'Archivo Variable',ui-sans-serif,system-ui,sans-serif;}.ds-pi{height:52px;display:flex;align-items:center;padding:0 16px;border-bottom:1px solid var(--rule);font-size:16px;color:var(--ink-faint)}.ds-pg{padding:10px 16px 6px;font-stretch:118%;font-weight:600;font-size:12px;letter-spacing:.08em;text-transform:uppercase;color:var(--ink-muted)}.ds-pr{padding:8px 16px;font-size:14px}.ds-pr b{font-variant-numeric:tabular-nums;margin-right:8px}"
