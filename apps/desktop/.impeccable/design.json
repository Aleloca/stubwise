  "components": [
    {
      "name": "Rail Control",
      "kind": "nav",
      "refersTo": "rail-control",
      "description": "40px icon button on the rail; ink tint on hover and current.",
      "html": "<a class=\"ds-rail-ctl\" aria-current=\"page\" href=\"#\"><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\"><path d=\"M4 11l8-7 8 7v9H4z\"/></svg></a>",
      "css": ":host{--ground:oklch(0.185 0.004 265);--surface:oklch(0.215 0.004 265);--rail:oklch(0.16 0.004 265);--ink:oklch(0.965 0.006 85);--ink-muted:oklch(0.76 0.006 265);--ink-faint:oklch(0.64 0.006 265);--rule:oklch(0.965 0.006 85 / 0.11);--rule-strong:oklch(0.965 0.006 85 / 0.2);--focus:oklch(0.74 0.13 250);--dept-4:oklch(0.68 0.18 32);}.ds-rail-ctl{display:grid;place-items:center;width:40px;height:40px;border-radius:8px;color:var(--ink-muted);transition:background-color 150ms cubic-bezier(.16,1,.3,1)}.ds-rail-ctl:hover{background:color-mix(in oklch,var(--ink) 6%,transparent);color:var(--ink)}.ds-rail-ctl[aria-current=page]{background:color-mix(in oklch,var(--ink) 10%,transparent);color:var(--ink)}.ds-rail-ctl:focus-visible{outline:2px solid var(--focus);outline-offset:2px}"
    },
    {
      "name": "Project Tile",
      "kind": "custom",
      "refersTo": "project-tile",
      "description": "Code on a bordered tile; solid ink dot = waiting on you, dashed ink ring = Claude working.",
      "html": "<span class=\"ds-tile-wrap\"><span class=\"ds-ring\"></span><a class=\"ds-tile\" href=\"#\"><span class=\"ds-code\">AUD</span></a><span class=\"ds-dot\"></span></span>",
      "css": ":host{--ground:oklch(0.185 0.004 265);--surface:oklch(0.215 0.004 265);--rail:oklch(0.16 0.004 265);--ink:oklch(0.965 0.006 85);--ink-muted:oklch(0.76 0.006 265);--ink-faint:oklch(0.64 0.006 265);--rule:oklch(0.965 0.006 85 / 0.11);--rule-strong:oklch(0.965 0.006 85 / 0.2);--focus:oklch(0.74 0.13 250);--dept-4:oklch(0.68 0.18 32);}.ds-tile-wrap{position:relative;display:inline-block;background:var(--rail);padding:8px}.ds-tile{position:relative;display:grid;place-items:center;width:40px;height:40px;border-radius:8px;border:1px solid var(--rule);color:var(--ink-muted)}.ds-tile:hover{border-color:var(--rule-strong);color:var(--ink)}.ds-code{font-family:'Archivo Variable',ui-sans-serif,system-ui,sans-serif;font-size:12px;font-weight:600;letter-spacing:.02em;font-variant-numeric:tabular-nums}.ds-ring{position:absolute;inset:4px;border-radius:12px;border:2px dashed var(--ink);pointer-events:none;animation:ds-p 1.8s infinite}.ds-dot{position:absolute;top:5px;right:5px;width:10px;height:10px;border-radius:9999px;background:var(--ink);border:2px solid var(--rail)}@keyframes ds-p{50%{opacity:.3}}@media (prefers-reduced-motion:reduce){.ds-ring{animation:none}}"
    },
    {
      "name": "Column Item",
      "kind": "nav",
      "refersTo": "column-item",
      "description": "32px section link in the project column with a faint count.",
      "html": "<a class=\"ds-item\" href=\"#\"><span>Tasks</span><span class=\"ds-n\">12</span></a>",
      "css": ":host{--ground:oklch(0.185 0.004 265);--surface:oklch(0.215 0.004 265);--rail:oklch(0.16 0.004 265);--ink:oklch(0.965 0.006 85);--ink-muted:oklch(0.76 0.006 265);--ink-faint:oklch(0.64 0.006 265);--rule:oklch(0.965 0.006 85 / 0.11);--rule-strong:oklch(0.965 0.006 85 / 0.2);--focus:oklch(0.74 0.13 250);--dept-4:oklch(0.68 0.18 32);}.ds-item{display:flex;align-items:center;gap:8px;height:32px;padding:0 10px;border-radius:6px;color:var(--ink-muted);font-size:14px;font-family:'Archivo Variable',ui-sans-serif,system-ui,sans-serif;text-decoration:none}.ds-item:hover{background:color-mix(in oklch,var(--ink) 6%,transparent);color:var(--ink)}.ds-n{margin-left:auto;font-size:12px;color:var(--ink-faint);font-variant-numeric:tabular-nums}.ds-item:focus-visible{outline:2px solid var(--focus);outline-offset:2px}"
    },
    {
      "name": "Task Row with Department Strip",
      "kind": "card",
      "refersTo": "column-item",
      "description": "Code-first row, inset 3px department bar at the left edge, name beside the code.",
      "html": "<div class=\"ds-row\" title=\"Department: Sales\"><span class=\"ds-strip\"></span><span class=\"ds-rc\">AUD-142</span><span class=\"ds-rt\">Send revised quote to client</span></div>",
      "css": ":host{--ground:oklch(0.185 0.004 265);--surface:oklch(0.215 0.004 265);--rail:oklch(0.16 0.004 265);--ink:oklch(0.965 0.006 85);--ink-muted:oklch(0.76 0.006 265);--ink-faint:oklch(0.64 0.006 265);--rule:oklch(0.965 0.006 85 / 0.11);--rule-strong:oklch(0.965 0.006 85 / 0.2);--focus:oklch(0.74 0.13 250);--dept-4:oklch(0.68 0.18 32);}.ds-row{position:relative;display:flex;align-items:center;gap:12px;height:44px;padding:0 16px;border-bottom:1px solid var(--rule);color:var(--ink);font-family:'Archivo Variable',ui-sans-serif,system-ui,sans-serif;font-size:14px;background:var(--ground)}.ds-strip{position:absolute;top:10px;bottom:10px;left:0;width:3px;border-radius:1px;background:var(--dept-4)}.ds-rc{font-size:13px;font-weight:600;font-variant-numeric:tabular-nums}.ds-row:hover{background:color-mix(in oklch,var(--ink) 4%,var(--ground))}"
    },
