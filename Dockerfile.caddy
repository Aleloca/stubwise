# syntax=docker/dockerfile:1

# Immagine Caddy che serve il bundle statico della web app e fa da reverse
# proxy verso il server (vedi Caddyfile). La web dist viene buildata qui e
# copiata dentro l'immagine: un'unica immagine, niente volume condiviso.

FROM node:22-slim AS web-build
ENV PNPM_HOME=/pnpm
ENV PATH="$PNPM_HOME:$PATH"
RUN corepack enable
WORKDIR /repo

COPY pnpm-workspace.yaml pnpm-lock.yaml package.json ./
COPY apps/server/package.json apps/server/package.json
COPY apps/worker/package.json apps/worker/package.json
COPY apps/web/package.json apps/web/package.json
COPY packages/db/package.json packages/db/package.json
COPY packages/shared/package.json packages/shared/package.json
COPY packages/git/package.json packages/git/package.json
COPY packages/sdk/package.json packages/sdk/package.json

RUN --mount=type=cache,id=pnpm-store,target=/pnpm/store \
    pnpm install --frozen-lockfile

COPY tsconfig.base.json ./
COPY packages packages
COPY apps/web apps/web
RUN pnpm --filter @stubwise/web... build

FROM caddy:2-alpine AS runtime
# Statici della SPA serviti da /srv/web (root nel Caddyfile).
COPY --from=web-build /repo/apps/web/dist /srv/web
# Placeholder per /docs finché il sito di documentazione (Task 28) non esiste:
# evita un 404/errore di Caddy su una root mancante.
RUN mkdir -p /srv/docs \
  && printf '<!doctype html><meta charset="utf-8"><title>Docs</title><p>La documentazione non e ancora pubblicata.</p>\n' > /srv/docs/index.html
COPY Caddyfile /etc/caddy/Caddyfile
