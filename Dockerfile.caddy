# syntax=docker/dockerfile:1

# Immagine Caddy che serve il bundle statico della web app e fa da reverse
# proxy verso il server (vedi Caddyfile). La web dist viene buildata qui e
# copiata dentro l'immagine: un'unica immagine, niente volume condiviso.

# Stage di build condiviso: SPA web (/srv/web) e sito di documentazione
# Starlight (/srv/docs). Entrambi i bundle statici nascono qui e vengono
# copiati nell'immagine Caddy finale.
FROM node:22-slim AS web-build
ENV PNPM_HOME=/pnpm
ENV PATH="$PNPM_HOME:$PATH"
RUN corepack enable
WORKDIR /repo

COPY pnpm-workspace.yaml pnpm-lock.yaml package.json ./
COPY apps/server/package.json apps/server/package.json
COPY apps/worker/package.json apps/worker/package.json
COPY apps/web/package.json apps/web/package.json
COPY apps/docs/package.json apps/docs/package.json
COPY packages/db/package.json packages/db/package.json
COPY packages/shared/package.json packages/shared/package.json
COPY packages/git/package.json packages/git/package.json
COPY packages/sdk/package.json packages/sdk/package.json

RUN --mount=type=cache,id=pnpm-store,target=/pnpm/store \
    pnpm install --frozen-lockfile

COPY tsconfig.base.json ./
COPY packages packages
COPY apps/web apps/web
RUN pnpm --filter @stubwise/web... build

# La documentazione: il prebuild di @stubwise/docs genera la spec OpenAPI
# importando buildApp() dai sorgenti del server (nessun db, nessuna istanza in
# esecuzione), poi `astro build` produce dist/ con base path /docs. Serve quindi
# anche il sorgente del server (apps/server) nel context di build.
COPY apps/server apps/server
COPY apps/docs apps/docs
# buildApp importa @stubwise/db/git/shared dai loro dist/ (esclusi dal context
# Docker via .dockerignore): vanno buildati prima del prebuild gen:openapi.
# `@stubwise/server^...` builda le DIPENDENZE del server (db, git, shared) senza
# il server stesso, che tsx esegue dai sorgenti.
RUN pnpm --filter @stubwise/server^... build
RUN pnpm --filter @stubwise/docs build

FROM caddy:2-alpine AS runtime
# Statici della SPA serviti da /srv/web (root nel Caddyfile).
COPY --from=web-build /repo/apps/web/dist /srv/web
# Documentazione Starlight servita da /srv/docs. Il sito è buildato con base
# path /docs (vedi astro.config.mjs): nel Caddyfile `handle_path /docs/*`
# strippa il prefisso /docs prima di servire da /srv/docs, e gli asset/link
# interni — già prefissati /docs — ripassano per lo stesso handle. Coerente.
COPY --from=web-build /repo/apps/docs/dist /srv/docs
COPY Caddyfile /etc/caddy/Caddyfile
