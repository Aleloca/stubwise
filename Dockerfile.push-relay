# syntax=docker/dockerfile:1

# Build multi-stage del relay push, sullo stesso schema di apps/server/Dockerfile:
# - stage "base": dipendenze del workspace dal lockfile, poi sorgenti e build;
# - stage finale: solo Node e l'output di `pnpm deploy`, senza toolchain.
#
# ⚠️ Questa immagine gira SOLO sul nostro VPS (servizio `push-relay` sotto il
# profilo compose `relay`): è lei a tenere le chiavi APNs/FCM legate alla nostra
# identità di publisher. Le istanze self-hosted non la costruiscono e non la
# avviano — chiamano il relay via HTTPS.

FROM node:22-slim AS base
ENV PNPM_HOME=/pnpm
ENV PATH="$PNPM_HOME:$PATH"
RUN corepack enable
WORKDIR /repo

# Manifest del workspace prima dei sorgenti, così il layer di install resta in
# cache finché lockfile/package.json non cambiano. Ne servono pochi: il relay
# dipende dal solo @stubwise/shared, e a differenza del server non tira dentro
# @stubwise/db né i pacchetti con dipendenze native (niente node-pty, quindi qui
# NON serve la toolchain python3/make/g++ che il Dockerfile del server installa).
COPY pnpm-workspace.yaml pnpm-lock.yaml package.json ./
COPY apps/push-relay/package.json apps/push-relay/package.json
COPY packages/shared/package.json packages/shared/package.json

RUN --mount=type=cache,id=pnpm-store,target=/pnpm/store \
    pnpm install --frozen-lockfile

COPY tsconfig.base.json ./
COPY packages/shared packages/shared
COPY apps/push-relay apps/push-relay

# `@stubwise/push-relay...` builda anche le sue dipendenze di workspace (shared).
RUN pnpm --filter "@stubwise/push-relay..." build

# node_modules di sola produzione, autoconsistente. --legacy: pnpm 10 senza
# inject-workspace-packages copia le workspace deps risolte (col loro dist)
# dentro node_modules/@stubwise/*.
RUN pnpm --filter @stubwise/push-relay deploy --prod --legacy /app

FROM node:22-slim AS runtime
ENV NODE_ENV=production
WORKDIR /app
RUN useradd --create-home --uid 10001 stubwise
COPY --from=base --chown=stubwise:stubwise /app /app
USER stubwise

EXPOSE 8090
# Healthcheck su /healthz, che è fuori dal rate limit per IP proprio perché una
# probe non deve consumare (né subire) la quota. Node nativo, niente curl.
HEALTHCHECK --interval=10s --timeout=5s --start-period=15s --retries=5 \
  CMD node -e "fetch('http://127.0.0.1:'+(process.env.PORT||8090)+'/healthz').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

CMD ["node", "dist/index.js"]
