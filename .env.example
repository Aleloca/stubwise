# Stubwise environment variables
# Copy to .env and fill in values.

# URL di connessione Postgres
DATABASE_URL=postgres://stubwise:stubwise@localhost:5432/stubwise

# Segreto per firmare le sessioni (minimo 32 caratteri)
# Genera con: openssl rand -hex 32
SESSION_SECRET=

# Chiave di cifratura per le credenziali salvate (32 byte in base64)
# Genera con: openssl rand -base64 32
ENCRYPTION_KEY=

# Porta su cui il server resta in ascolto (default: 3000)
PORT=3000

# URL pubblico con cui l'istanza è raggiungibile (usato per link e webhook)
PUBLIC_URL=http://localhost:3000

# --- Worker AI ---
# Il worker riusa DATABASE_URL e ENCRYPTION_KEY (la STESSA chiave del server:
# decifra le credenziali git dei progetti cifrate dal server). Riusa anche
# PUBLIC_URL (sopra), ma SOLO per comporre il link al ticket nelle notifiche
# webhook in uscita: vuoto = il link è il solo path (/tickets/:id).

# Directory dei mirror git persistenti del worker (default: /var/stubwise/mirrors)
MIRRORS_DIR=

# Job AI in lavorazione contemporanea, su progetti diversi (default: 2)
WORKER_CONCURRENCY=

# Dimensione del pool di connessioni Postgres del worker (default: 10). Alzalo in
# proporzione a WORKER_CONCURRENCY: i job concorrenti si contendono le connessioni.
# Non superare il max_connections di Postgres (default 100).
DATABASE_POOL_MAX=

# Minuti di inattività oltre cui un job in lavorazione è considerato orfano di
# un worker crashato e riportato in coda (default: 150). DEVE superare ~119
# minuti con il fix in due fasi + self-repair (plan 10' + fix 30' + 2 RE-tentativi
# × (fix 30' + test 5') + 2× triage 2' + margine 5'). Con SELF_REPAIR_MAX_ATTEMPTS=0
# e FIX_TWO_PHASE=false la soglia richiesta scende a ~40'. Un valore troppo basso
# riaccoderebbe un job lungo ma vivo generando una PR duplicata. Il worker
# verifica l'invariante all'avvio e SI RIFIUTA DI PARTIRE (exit 1) se è violata.
WORKER_STALE_MINUTES=

# --- Fix in DUE FASI (riduzione costi) ---
# Il fix gira in due run: un modello FORTE pianifica in sola lettura (analisi +
# piano, nessuna modifica), un modello ECONOMICO esegue il piano (scrive il fix,
# il test e il report). I consumi dei due modelli sono registrati separatamente.
# Modello del run di pianificazione (default: opus).
FIX_PLAN_MODEL=
# Modello del run di esecuzione (default: sonnet).
FIX_EXECUTE_MODEL=
# true (default) = due fasi; false = un solo run con FIX_EXECUTE_MODEL
# (comportamento storico, per confronto/rollback).
FIX_TWO_PHASE=
# Timeout del run di pianificazione in millisecondi (default: 600000 = 10').
# Entra nell'invariante di staleness (plan + fix), tienilo coerente con
# WORKER_STALE_MINUTES.
FIX_PLAN_TIMEOUT_MS=

# --- Self-repair (il worker ri-esegue i test e cicla con feedback) ---
# Dopo l'esecuzione, se il repo ha un comando di test risolvibile, il worker
# esegue da sé i test nel worktree e, se falliscono, reinvoca l'agente con
# l'output del fallimento, fino a N RE-tentativi; solo con test verdi committa
# e apre la PR. Numero massimo di RE-tentativi (default: 2; 0 = disattivato,
# comportamento storico: si committa senza eseguire i test). Entra
# nell'invariante di staleness.
SELF_REPAIR_MAX_ATTEMPTS=
# Timeout di ogni esecuzione del comando di test in millisecondi
# (default: 300000 = 5'). Entra nell'invariante di staleness.
SELF_REPAIR_TEST_TIMEOUT_MS=

# --- Usage residuo dell'abbonamento (poller `/usage` via PTY) ---
# Ogni N minuti il worker legge l'utilizzo residuo di ogni credenziale "account"
# eseguendo il comando `/usage` (lettura GRATUITA, non consuma token) e ne salva
# uno snapshot. È un task SEPARATO dal loop dei job e BEST-EFFORT: non fa mai
# crashare il worker e non tocca i timeout/heartbeat dei job. Default: 5;
# 0 = disabilitato.
USAGE_POLL_MINUTES=

# --- Resume automatico al rientro dei limiti provider (worker) ---
# Ogni N minuti il worker riprende ciò che si è fermato per LIMITE di rate/usage
# di un provider AI: generazioni Docs in pausa (paused → running) e job in stato
# held con ragione "limit" (→ queued; budget/gate restano decisioni umane).
# La decisione usa l'ultimo snapshot /usage fresco per le credenziali "account"
# (headroom = sessione usata sotto la soglia e weekly < 100%); per le api_key o
# con snapshot stantio/assente si degrada a un fallback A TEMPO (cooldown), così
# nulla resta fermo per sempre anche con USAGE_POLL_MINUTES=0. Task separato dal
# loop dei job, best-effort. Default: 5; 0 = disabilitato.
LIMIT_RESUME_POLL_MINUTES=
# Soglia di headroom: una credenziale "account" è di nuovo utilizzabile quando
# la sessione usata (snapshot /usage fresco) è SOTTO questa percentuale.
# Default: 95 (si riparte con almeno il 5% di sessione libera).
LIMIT_RESUME_HEADROOM_PERCENT=
# Cooldown (minuti) del fallback a tempo: per le api_key (nessuno snapshot
# /usage) o con snapshot stantio la ripresa avviene quando la pausa dura da più
# di questo tempo. Default: 60.
LIMIT_RESUME_API_KEY_COOLDOWN_MINUTES=

# --- Test delle credenziali AI (worker, su richiesta dall'admin) ---
# Ogni N secondi il worker raccoglie le richieste di test marcate dal server
# (bottone "Test" in Settings → AI providers) ed esegue un `claude -p` minimale
# con quella credenziale per validarne l'autenticazione. È un task SEPARATO dal
# loop dei job e BEST-EFFORT: non fa mai crashare il worker e non tocca i
# timeout/heartbeat dei job. Default: 5; 0 = disabilitato.
CREDENTIAL_TEST_POLL_SECONDS=

# --- Embedding documentazione autogenerata (server + worker) ---
# La sezione "Docs" genera documentazione per progetto e la rende ricercabile
# (ricerca semantica + chat RAG su pgvector). Server e worker chiamano un
# servizio di embedding con API OpenAI-compatibile (/v1/embeddings).
# Nello stack compose è il servizio self-hosted `ollama` con il modello bge-m3
# (1024 dim): scaricalo UNA volta dopo il primo `up` con
#   docker compose exec ollama ollama pull bge-m3
# Lascia vuote queste variabili per usare i default del compose qui sotto.
# URL base OpenAI-compatibile (default compose: http://ollama:11434/v1).
EMBEDDING_BASE_URL=
# Modello di embedding (default: bge-m3, 1024 dim). Cambiare famiglia con una
# dimensione diversa richiede una migrazione DB (la dim è fissata nello schema).
EMBEDDING_MODEL=
# API key opzionale: Ollama NON ne richiede una (lascia vuota). Valorizzala solo
# se punti EMBEDDING_BASE_URL a un provider che richiede Authorization.
EMBEDDING_API_KEY=
# --- Generazione documentazione: motore ricorsivo (server + worker) ---
# La generazione costruisce un DAG di nodi durabili: orientamento framework-aware
# → esplorazione ricorsiva (un run dell'agente per nodo) → sintesi/join →
# cross-link → proiezione in doc_pages annidate + embedding. Tutti i run sono in
# SOLA LETTURA su un worktree effimero.
# Modello dell'agente che scrive le pagine (orientamento/explore/synthesize).
# Forte per default (qualità della prosa e comprensione del codice). Vuoto =
# default opus.
DOC_GENERATION_MODEL=
# Profondità massima del DAG ricorsivo: un nodo a questa profondità è trattato
# come FOGLIA anche se l'esplorazione proporrebbe altri figli (i figli scartati
# sono LOGGATI, mai un cap silenzioso). Safeguard anti-runaway su repo molto
# annidati — NON un limite di costo. Vuoto = default 6 (≈ radice + 5 livelli).
DOC_MAX_DEPTH=
# Tetto al numero TOTALE di nodi del DAG in una singola generazione: ogni nodo è
# un run dell'agente, quindi la creazione dei figli che supererebbe questo tetto
# viene TAGLIATA (figli scartati loggati, mai un cap silenzioso). Safeguard
# anti-runaway su repo molto grandi. Vuoto = default 400.
DOC_MAX_NODES=
# NB: il motore ricorsivo NON ha un cap di costo in dollari. Il costo è limitato
# strutturalmente dai safeguard DOC_MAX_DEPTH e DOC_MAX_NODES sopra (ogni nodo è
# un run dell'agente, quindi profondità e numero di nodi bound il costo totale).
# Il costo resta tracciato per-nodo e aggregato in doc_generations.cost.
# Timeout (ms) di OGNI singola chiamata dell'agente nel DAG di generazione dei
# Docs (orientamento, esplorazione di un nodo, sintesi di un'area). Più corto del
# timeout del fix: una chiamata appesa fallisce in ~8' (default) e va in
# best-effort (il nodo viene riprovato una volta poi fallito, senza bloccare il
# resto del DAG) invece di tenere il job bloccato a lungo. Vuoto = default 480000
# (8 minuti).
DOC_AGENT_TIMEOUT_MS=
# Tetto al numero di pagine PRODUCT create PER VERTICALE (Fase B, classe pubblica):
# dopo la chiusura dei due alberi interni, per ogni superficie PUBBLICA UI del brief si
# genera una verticale (radice + guide per journey + FAQ) fino a questo tetto PER
# SUPERFICIE (ogni verticale riparte col suo budget, così le superfici successive non
# restano affamate). Budget SEPARATO da DOC_MAX_NODES. 0 = fase product disattivata
# (nessuna verticale pubblica; retrocompatibilità totale). Vuoto = default 12.
DOC_PRODUCT_MAX_PAGES=

# Intervallo (secondi) del poller di auto-aggiornamento Docs (changelog/release):
# reclama i pending di doc_auto_update_jobs scaduti (debounce dei push) ed esegue
# l'agente che produce la entry "release". Task separato dal loop dei job,
# best-effort, non tocca i timeout dei job. 0 = disabilitato. Vuoto = default 60.
DOCS_AUTOUPDATE_POLL_SECONDS=

# Tetto al numero di pagine di documentazione che l'auto-aggiornamento Docs rigenera
# in-place ad ogni push (Fase 2): l'agente di refresh riscrive solo le pagine il cui
# sourcePath è toccato dal diff, fino a questo cap (le altre impattate sono segnalate
# come troncate nella entry release). 0 = disabilita la rigenerazione mirata lasciando
# solo la entry release. Vuoto = default 10.
DOCS_AUTOUPDATE_MAX_PAGES=

# Intervallo (secondi) del poller dell'automazione PR Review: reclama i pending
# di pr_review_jobs scaduti (debounce dei push sulla PR) ed esegue l'agente di
# review (read-only, plan mode: verdetto + analisi, non modifica nulla). Task
# separato dal loop dei job, best-effort, non tocca i timeout dei job.
# 0 = disabilitato. Vuoto = default 60.
PR_REVIEW_POLL_SECONDS=
# Modello dell'agente di PR Review. Economico per default: la review gira ad
# ogni push su ogni PR aperta. Vuoto = default sonnet.
PR_REVIEW_MODEL=
# Turni massimi del run di review (limita esplorazione, costo e durata per
# review). Vuoto = default 50.
PR_REVIEW_MAX_TURNS=
# Timeout (MINUTI) del run dell'agente di review. Deve restare SOTTO
# WORKER_STALE_MINUTES: il recovery del poller chiude failed le review running
# senza heartbeat da quella soglia. Vuoto = default 15.
PR_REVIEW_TIMEOUT_MINUTES=

# Daily activity report (standup notturno dai commit)
# Intervallo del poller in minuti (0 = disabilitato). Vuoto = default 15.
DAILY_REPORT_POLL_MINUTES=
# Massimo autori per progetto per cui generare il riassunto AI (oltre: solo dati
# grezzi). Vuoto = default 25.
DAILY_REPORT_MAX_AUTHORS_PER_PROJECT=
# Giorni di retention dei report prima della pulizia. Vuoto = default 90.
DAILY_REPORT_RETENTION_DAYS=

# Backlog di discovery (raccolta + dedup + raffinamento di feedback/feature)
# Soglia di similarità (0–1) sopra cui l'intake FONDE un nuovo feedback in una
# voce esistente (dedup automatico). Vuoto = default 0.90.
BACKLOG_MERGE_THRESHOLD=
# Soglia di similarità (0–1) sopra cui una nuova voce segnala "simile a X" (zona
# grigia, sotto la merge). Deve essere ≤ BACKLOG_MERGE_THRESHOLD. Vuoto = default 0.78.
BACKLOG_SIMILAR_THRESHOLD=
# Intervallo del poller in secondi (0 = disabilitato). Vuoto = default 20.
BACKLOG_POLL_SECONDS=
# Modello dell'agente del backlog (intake + deep dive). Vuoto = default sonnet.
BACKLOG_MODEL=
# Timeout (ms) di ogni run dell'agente del backlog. Vuoto = default 900000 (15').
BACKLOG_AGENT_TIMEOUT_MS=
# Sessione di analisi sul codice nella chat del backlog (turni dell'agente claude
# CLI su un worktree read-only, con sessione persistente).
# Intervallo del poller VELOCE dei turni in secondi (0 = disabilitato, i turni non
# vengono elaborati). Vuoto = default 2.
BACKLOG_CHAT_TURN_POLL_SECONDS=
# Minuti di inattività oltre cui una sessione active viene chiusa (sweep TTL:
# worktree rimosso + messaggio system). Vuoto = default 30.
BACKLOG_CHAT_SESSION_TTL_MINUTES=
# Timeout (ms) del run dell'agente per un turno di chat. Vuoto = default 300000 (5').
BACKLOG_CHAT_TURN_TIMEOUT_MS=
# Turni massimi dell'agente per un turno di chat. Vuoto = default 15.
BACKLOG_CHAT_TURN_MAX_TURNS=

# Knowledge graph del codice (graphify): estrazione per-repository dal worker.
# Radice del volume condiviso dei grafi: il worker ci scrive
# <GRAPHS_DIR>/<repositoryId>/graphify-out/, il server la monta read-only per
# servire report/html/json. Vuoto = default /graphs.
GRAPHS_DIR=
# Labeling delle comunità col backend claude-cli (nomi al posto di
# "Community N"). false = grafo comunque valido, solo con i placeholder.
# Vuoto = default true.
GRAPH_LABEL_ENABLED=
# Binario del CLI graphify (nome in PATH o path assoluto). Vuoto = default graphify.
GRAPHIFY_BIN=
# Timeout in minuti di OGNI invocazione del CLI graphify (extract, clustering,
# export html). Vuoto = default 20.
GRAPH_BUILD_TIMEOUT_MINUTES=

# =============================================================================
# DEPLOY — Docker Compose (self-hosting)
# =============================================================================
# Le variabili qui sotto valgono SOLO per `docker compose up` (vedi
# docker-compose.yml e README → "Self-hosting con Docker Compose"). In dev
# locale non servono. Le variabili dev qui sopra (DATABASE_URL, SESSION_SECRET,
# ecc.) vengono riusate dal compose: per il deploy reimposta DATABASE_URL in
# modo che punti al servizio `postgres` (host = postgres, non localhost).

# Password dell'utente Postgres dentro al container (OBBLIGATORIA per il deploy).
POSTGRES_PASSWORD=
# Opzionali: default utente/db = stubwise.
POSTGRES_USER=stubwise
POSTGRES_DB=stubwise

# Per il deploy DATABASE_URL deve puntare al servizio postgres del compose e
# combaciare con POSTGRES_USER/PASSWORD/DB qui sopra. Esempio:
#   DATABASE_URL=postgres://stubwise:LA_TUA_PASSWORD@postgres:5432/stubwise

# Dominio pubblico servito da Caddy.
#   - FQDN (es. stubwise.example.com): HTTPS automatico via Let's Encrypt.
#   - localhost: HTTPS con CA interna di Caddy (certificato self-signed).
#   - :80: solo HTTP, niente TLS (smoke test locali).
# Imposta anche PUBLIC_URL coerente (https://<DOMAIN> in produzione).
DOMAIN=localhost

# Soglia di staleness del worker per il deploy (default: 150 minuti).
# Lasciala vuota/non impostata per usare il default. ATTENZIONE: con il fix in
# due fasi + self-repair attivi DEVE superare ~119 minuti (plan 10' + fix 30' +
# 2 RE-tentativi × (fix 30' + test 5') + 2× triage 2' + margine 5'). Altrimenti
# il worker si rifiuta di partire (exit 1) e con `restart: unless-stopped` va in
# crash-loop.
WORKER_STALE_MINUTES=

# Auth del CLI claude nel worker (scegli UNA via):
#   1) ANTHROPIC_API_KEY: la più semplice in produzione.
#   2) Login OAuth/MAX: lascia vuota questa variabile ed esegui
#      `docker compose exec worker claude login` (il token persiste nel volume
#      claude-config). Vedi README.
ANTHROPIC_API_KEY=
