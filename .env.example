# Stubwise environment variables
# Copy to .env and fill in values.

# URL di connessione Postgres
DATABASE_URL=postgres://stubwise:stubwise@localhost:5432/stubwise

# Segreto per firmare le sessioni (minimo 32 caratteri)
# Genera con: openssl rand -hex 32
SESSION_SECRET=

# Chiave di cifratura per le credenziali salvate (32 byte in base64)
# Genera con: openssl rand -base64 32
ENCRYPTION_KEY=

# Porta su cui il server resta in ascolto (default: 3000)
PORT=3000

# URL pubblico con cui l'istanza è raggiungibile (usato per link e webhook)
PUBLIC_URL=http://localhost:3000

# --- Worker AI ---
# Il worker riusa DATABASE_URL e ENCRYPTION_KEY (la STESSA chiave del server:
# decifra le credenziali git dei progetti cifrate dal server). Riusa anche
# PUBLIC_URL (sopra), ma SOLO per comporre il link al ticket nelle notifiche
# webhook in uscita: vuoto = il link è il solo path (/tickets/:id).

# Directory dei mirror git persistenti del worker (default: /var/stubwise/mirrors)
MIRRORS_DIR=

# Job AI in lavorazione contemporanea, su progetti diversi (default: 2)
WORKER_CONCURRENCY=

# Minuti di inattività oltre cui un job in lavorazione è considerato orfano di
# un worker crashato e riportato in coda (default: 60). DEVE superare ~49 minuti
# con il fix in due fasi attivo (plan 10' + fix 30' + 2× triage 2' + margine 5');
# ~40 minuti con FIX_TWO_PHASE=false (solo fix 30'). Un valore troppo basso
# riaccoderebbe un job lungo ma vivo generando una PR duplicata. Il worker
# verifica l'invariante all'avvio e SI RIFIUTA DI PARTIRE (exit 1) se è violata.
WORKER_STALE_MINUTES=

# --- Fix in DUE FASI (riduzione costi) ---
# Il fix gira in due run: un modello FORTE pianifica in sola lettura (analisi +
# piano, nessuna modifica), un modello ECONOMICO esegue il piano (scrive il fix,
# il test e il report). I consumi dei due modelli sono registrati separatamente.
# Modello del run di pianificazione (default: opus).
FIX_PLAN_MODEL=
# Modello del run di esecuzione (default: sonnet).
FIX_EXECUTE_MODEL=
# true (default) = due fasi; false = un solo run con FIX_EXECUTE_MODEL
# (comportamento storico, per confronto/rollback).
FIX_TWO_PHASE=
# Timeout del run di pianificazione in millisecondi (default: 600000 = 10').
# Entra nell'invariante di staleness (plan + fix), tienilo coerente con
# WORKER_STALE_MINUTES.
FIX_PLAN_TIMEOUT_MS=

# =============================================================================
# DEPLOY — Docker Compose (self-hosting)
# =============================================================================
# Le variabili qui sotto valgono SOLO per `docker compose up` (vedi
# docker-compose.yml e README → "Self-hosting con Docker Compose"). In dev
# locale non servono. Le variabili dev qui sopra (DATABASE_URL, SESSION_SECRET,
# ecc.) vengono riusate dal compose: per il deploy reimposta DATABASE_URL in
# modo che punti al servizio `postgres` (host = postgres, non localhost).

# Password dell'utente Postgres dentro al container (OBBLIGATORIA per il deploy).
POSTGRES_PASSWORD=
# Opzionali: default utente/db = stubwise.
POSTGRES_USER=stubwise
POSTGRES_DB=stubwise

# Per il deploy DATABASE_URL deve puntare al servizio postgres del compose e
# combaciare con POSTGRES_USER/PASSWORD/DB qui sopra. Esempio:
#   DATABASE_URL=postgres://stubwise:LA_TUA_PASSWORD@postgres:5432/stubwise

# Dominio pubblico servito da Caddy.
#   - FQDN (es. stubwise.example.com): HTTPS automatico via Let's Encrypt.
#   - localhost: HTTPS con CA interna di Caddy (certificato self-signed).
#   - :80: solo HTTP, niente TLS (smoke test locali).
# Imposta anche PUBLIC_URL coerente (https://<DOMAIN> in produzione).
DOMAIN=localhost

# Soglia di staleness del worker per il deploy (default: 60 minuti).
# Lasciala vuota/non impostata per usare il default. ATTENZIONE: con il fix in
# due fasi attivo DEVE superare ~49 minuti (plan 10' + fix 30' + 2× triage 2' +
# margine 5'); ~40 minuti con FIX_TWO_PHASE=false. Altrimenti il worker si
# rifiuta di partire (exit 1) e con `restart: unless-stopped` va in crash-loop.
WORKER_STALE_MINUTES=

# Auth del CLI claude nel worker (scegli UNA via):
#   1) ANTHROPIC_API_KEY: la più semplice in produzione.
#   2) Login OAuth/MAX: lascia vuota questa variabile ed esegui
#      `docker compose exec worker claude login` (il token persiste nel volume
#      claude-config). Vedi README.
ANTHROPIC_API_KEY=
